using System;
using System.Collections.Generic;
using System.IO;

class Program
{
    public class Loan
    {
        public string ClientName { get; set; }
        public double Principal { get; set; }
        public double InterestRate { get; set; } // percentage
    }

    static void Main()
    {
        string path = "loans.csv";

        // ---------- WRITE SECTION (Append Mode) ----------
        bool fileExists = File.Exists(path);

        using (StreamWriter sw = new StreamWriter(path, true)) // append mode
        {
            // write header only once
            if (!fileExists)
            {
                sw.WriteLine("ClientName,Principal,InterestRate");
            }

            Console.Write("Enter Client Name: ");
            string name = Console.ReadLine();

            Console.Write("Enter Principal Amount: ");
            double principal;
            while (!double.TryParse(Console.ReadLine(), out principal))
            {
                Console.Write("Invalid number. Enter Principal again: ");
            }

            Console.Write("Enter Interest Rate (%): ");
            double rate;
            while (!double.TryParse(Console.ReadLine(), out rate))
            {
                Console.Write("Invalid number. Enter Interest Rate again: ");
            }

            sw.WriteLine($"{name},{principal},{rate}");
        }

        Console.WriteLine("\nLoan saved successfully.\n");

        // ---------- READ SECTION ----------
        List<Loan> loans = new List<Loan>();

        using (StreamReader reader = new StreamReader(path))
        {
            reader.ReadLine(); // skip header

            string line;
            while ((line = reader.ReadLine()) != null)
            {
                string[] parts = line.Split(',');

                if (parts.Length != 3)
                    continue; // skip bad rows

                if (double.TryParse(parts[1], out double principal) &&
                    double.TryParse(parts[2], out double rate))
                {
                    loans.Add(new Loan
                    {
                        ClientName = parts[0],
                        Principal = principal,
                        InterestRate = rate
                    });
                }
            }
        }

        // ---------- DISPLAY SECTION ----------
        Console.WriteLine("Loan Portfolio Analysis");
        Console.WriteLine("------------------------");

        foreach (var loan in loans)
        {
            double interestAmount = loan.Principal * loan.InterestRate / 100;
            string risk = GetRiskLevel(loan.InterestRate);

            Console.WriteLine(
                $"{loan.ClientName,-15} | " +
                $"Principal: {loan.Principal:C} | " +
                $"Interest: {interestAmount:C} | " +
                $"Risk: {risk}"
            );
        }
    }

    static string GetRiskLevel(double rate)
    {
        if (rate > 10)
            return "High Risk";
        else if (rate >= 5)
            return "Medium Risk";
        else
            return "Low Risk";
    }
}
