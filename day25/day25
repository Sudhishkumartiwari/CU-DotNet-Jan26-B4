using System;

class Program
{
    static void Main(string[] args)
    {
        string pin = "";

        Console.WriteLine("Enter 4-digit PIN:");

        while (pin.Length < 4)
        {
            ConsoleKeyInfo keyInfo = Console.ReadKey(true);

            if (char.IsDigit(keyInfo.KeyChar))
            {
                pin += keyInfo.KeyChar;
                Console.Write("*");
            }
        }

        Console.WriteLine();
        Console.WriteLine("Entered PIN is: " + pin);
    }
}