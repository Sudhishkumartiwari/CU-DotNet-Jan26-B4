using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace opps
{
    class Height
    {
        public int Feet { get; set; }
        public double Inch { get; set; }
        public Height()
        {
            int Feet = 0;
            double Inch = 0.0;
        }
        public Height(int feet, double inch)
        {
            Feet = feet;
            Inch = inch;
            roundoff();
        }
        public Height(double Inches)
        {
            Feet = (int)(Inches / 12);
            Inch = Inches % 12;
        }
        public void roundoff()
        {
            if (Inch >= 12)
            {
                Feet += (int)(Inch / 12);
                Inch = Inch % 12;
            }
        }
        public Height AddHeight(Height h)
        {
            int totalFeet = Feet + h.Feet;
            double totalInches = Inch + h.Inch;
            return new Height(totalFeet, totalInches);
        }
        //public static Height operator +(Height h1,Height h2)
        //{
        //    int total
        //}

        public override string ToString()
        {
            return $"Height - {Feet} feet {Inch:F1} inches";
        }

    }
    internal class Heightt
    {
        static void Main(string[] args)
        {
            Height person1 = new Height(5, 8.5);
            Height person2 = new Height(6, 3.5);
            Height person3 = new Height(125);
            Height totalHeight = person1.AddHeight(person2);
            Console.WriteLine("Person 1: " + person1);
            Console.WriteLine("Person 2: " + person2);
            Console.WriteLine("Total Height: " + totalHeight);
            Console.WriteLine("total height " + person3);
        }
    }
}
