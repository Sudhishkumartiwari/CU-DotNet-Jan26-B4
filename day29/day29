using System;
using System.Collections.Generic;

abstract class KitchenAppliance
{
    public string ModelName { get; set; }
    public int PowerConsumption { get; set; }

    public KitchenAppliance(string modelName, int power)
    {
        ModelName = modelName;
        PowerConsumption = power;
    }

    public abstract void Cook();

    public virtual void Preheat()
    {
        Console.WriteLine(ModelName + " starts cooking immediately.");
    }
}

interface ITimer
{
    void SetTimer(int minutes);
}

interface IWifi
{
    void ConnectWifi();
}

class Microwave : KitchenAppliance, ITimer
{
    public Microwave(string modelName, int power) : base(modelName, power) { }

    public void SetTimer(int minutes)
    {
        Console.WriteLine(ModelName + " timer set for " + minutes + " minutes.");
    }

    public override void Cook()
    {
        Console.WriteLine(ModelName + " is heating food using microwaves.");
    }
}

class ElectricOven : KitchenAppliance, ITimer, IWifi
{
    public ElectricOven(string modelName, int power) : base(modelName, power) { }

    public void SetTimer(int minutes)
    {
        Console.WriteLine(ModelName + " timer set for " + minutes + " minutes.");
    }

    public void ConnectWifi()
    {
        Console.WriteLine(ModelName + " connected to WiFi for remote monitoring.");
    }

    public override void Preheat()
    {
        Console.WriteLine(ModelName + " is preheating before cooking.");
    }

    public override void Cook()
    {
        Preheat();
        Console.WriteLine(ModelName + " is baking food evenly.");
    }
}

class AirFryer : KitchenAppliance
{
    public AirFryer(string modelName, int power) : base(modelName, power) { }

    public override void Cook()
    {
        Console.WriteLine(ModelName + " is frying food with rapid air technology.");
    }
}

class Program
{
    static void Main(string[] args)
    {
        List<KitchenAppliance> appliances = new List<KitchenAppliance>
        {
            new Microwave("MicroX 200", 1200),
            new ElectricOven("OvenPro 500", 2000),
            new AirFryer("AirQuick 100", 1500)
        };

        foreach (var device in appliances)
        {
            Console.WriteLine("Model: " + device.ModelName);
            device.Cook();

            if (device is IWifi wifiDevice)
            {
                wifiDevice.ConnectWifi();
            }

            Console.WriteLine("--------------------------------");
        }
    }
}