using System.Data;

namespace Weekassignment
{
    public interface IBonusStrategy
    {
        decimal CalculateBonus(decimal baseSalary, decimal currentBonus, EmployeeBonus employee);
     
    }
    public class EmployeeBonus
    {
        public decimal BaseSalary { get; set; }
        public int PerformanceRating { get; set; }
        public int MyProperYearsOfExperiencety { get; set; }
        public decimal DepartmentMultiplier { get; set; }
        public double AttendancePercentage { get; set; }
        public readonly List<IBonusStrategy> rules;
        public EmployeeBonus(
          decimal BaseSalary, int PerformanceRating, int MyProperYearsOfExperiencety,
          decimal DepartmentMultiplier, double AttendancePercentage)
        {
            this.BaseSalary = BaseSalary;
            this.PerformanceRating = PerformanceRating;
            this.MyProperYearsOfExperiencety = MyProperYearsOfExperiencety;
            this.DepartmentMultiplier = DepartmentMultiplier;
            this.AttendancePercentage = AttendancePercentage;

            rules = new List<IBonusStrategy>
                      {
             new Bonusrating(),
             new ExperienceBonusRule(),
             new AttendancePenaltyRule(),
             new DepartmentMultiplierRule(),
             new BonusCapRule(),
             new TaxRule()
             };
        }
        public decimal NetAnnualBonus
        {
            get
            {
                if (BaseSalary <= 0)
                    return 0;
                if (AttendancePercentage < 0 || AttendancePercentage > 100)
                    throw new InvalidOperationException("Attendance must be between 0 and 100");
                decimal bonus = 0;
                foreach (var rule in rules)
                {
                    bonus = rule.CalculateBonus(BaseSalary, bonus, this);
                }
                return Math.Round(bonus, 2);
            }
        }

    }
    public class Bonusrating : IBonusStrategy
    {
        public decimal CalculateBonus(decimal baseSalary, decimal currentBonus, EmployeeBonus employee)
        {
            var ratingMap = new Dictionary<int, decimal>
            {
                {5, 0.25m},
                {4, 0.18m},
                {3, 0.12m},
                {2, 0.05m},
                {1, 0.00m}
            };

            if (!ratingMap.ContainsKey(employee.PerformanceRating))
                throw new InvalidOperationException("Rating must be between 1 and 5");

            return baseSalary * ratingMap[employee.PerformanceRating];
        }
    }
    public class ExperienceBonusRule : IBonusStrategy
    {
        public decimal CalculateBonus(decimal baseSalary, decimal currentBonus, EmployeeBonus employee)
        {
            if (employee.MyProperYearsOfExperiencety > 10)
                return currentBonus + (baseSalary * 0.05m);

            if (employee.MyProperYearsOfExperiencety > 5)
                return currentBonus + (baseSalary * 0.03m);

            return currentBonus;
        }
    }

    // Step 3 – Attendance Penalty
    public class AttendancePenaltyRule : IBonusStrategy
    {
        public decimal CalculateBonus(decimal baseSalary, decimal currentBonus, EmployeeBonus employee)
        {
            if (employee.AttendancePercentage < 85)
                return currentBonus - (currentBonus * 0.20m);

            return currentBonus;
        }
    }

    // Step 4 – Department Multiplier
    public class DepartmentMultiplierRule : IBonusStrategy
    {
        public decimal CalculateBonus(decimal baseSalary, decimal currentBonus, EmployeeBonus employee)
        {
            return currentBonus * employee.DepartmentMultiplier;
        }
    }
    // Step 5 – Maximum Cap (40%)
    public class BonusCapRule : IBonusStrategy
    {
        public decimal CalculateBonus(decimal baseSalary, decimal currentBonus, EmployeeBonus employee)
        {
            decimal maxAllowed = baseSalary * 0.40m;

            if (currentBonus > maxAllowed)
                return maxAllowed;

            return currentBonus;
        }
    }
    // Step 6 – Tax Deduction
    public class TaxRule : IBonusStrategy
    {
        public decimal CalculateBonus(decimal baseSalary, decimal currentBonus, EmployeeBonus employee)
        {
            decimal taxRate;

            if (currentBonus <= 150000)
                taxRate = 0.10m;
            else if (currentBonus <= 300000)
                taxRate = 0.20m;
            else
                taxRate = 0.30m;

            return currentBonus - (currentBonus * taxRate);
        }
    }

    internal class Program
    {
        static void Main(string[] args)
        {
            EmployeeBonus emp = new EmployeeBonus(
                1000000m,  // Base Salary
                5,         // Rating
                8,         // Experience
                1.2m,      // Department Multiplier
                90         // Attendance
            );
            Console.WriteLine($"Final Net Annual Bonus: {emp.NetAnnualBonus}");
        }
    }
}
