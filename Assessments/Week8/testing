using NUnit.Framework;
using System;
using Weekassignment;

namespace Weekassignment.Tests
{
    public class EmployeeBonusTests
    {
     
        [Test]
        public void NormalHighPerformer_ShouldReturnCorrectBonus()
        {
            var emp = new EmployeeBonus(
                500000m,
                5,
                6,
                1.1m,
                95
            );
            Assert.AreEqual(123200.00m, emp.NetAnnualBonus);
        }
        [Test]
        public void AttendancePenalty_ShouldReduceBonus()
        {
            var emp = new EmployeeBonus(
                400000m,
                4,
                8,
                1.0m,
                80
            );

            Assert.AreEqual(60480.00m, emp.NetAnnualBonus);
        }
        [Test]
        public void CapRule_ShouldLimitBonusTo40Percent()
        {
            var emp = new EmployeeBonus(
                1000000m,
                5,
                15,
                1.5m,
                95
            );
            Assert.AreEqual(280000.00m, emp.NetAnnualBonus);
        }
        [Test]
        public void ZeroSalary_ShouldReturnZero()
        {
            var emp = new EmployeeBonus(
                0m,
                5,
                5,
                1.0m,
                90
            );
            Assert.AreEqual(0.00m, emp.NetAnnualBonus);
        }
        [Test]
        public void LowPerformer_ShouldReturnCorrectBonus()
        {
            var emp = new EmployeeBonus(
                300000m,
                2,
                3,
                1.0m,
                90
            );
            Assert.AreEqual(13500.00m, emp.NetAnnualBonus);
        }
        [Test]
        public void Exact150kBoundary_ShouldApply10PercentTax()
        {
            var emp = new EmployeeBonus(
                600000m,
                3,
                0,
                1.0m,
                100
            );
            Assert.AreEqual(64800.00m, emp.NetAnnualBonus);
        }
        [Test]
        public void HighTaxSlab_ShouldApply30PercentTax()
        {
            var emp = new EmployeeBonus(
                900000m,
                5,
                11,
                1.2m,
                100
            );

            Assert.AreEqual(226800.00m, emp.NetAnnualBonus);
        }
        [Test]
        public void RoundingPrecision_ShouldRoundToTwoDecimals()
        {
            var emp = new EmployeeBonus(
                555555m,
                4,
                6,
                1.13m,
                92
            );
            Assert.AreEqual(118649.88m, emp.NetAnnualBonus);
        }

      
    }
}
