using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace opps
{
    abstract class Patient
    {
        public string Name { get; set; }
        public decimal BaseFee { get; set; }
        public virtual decimal CalculateFinalBill()
        {
            return BaseFee;
        }
    }
    class Inpatient : Patient
    {
        public int DaysStayed { get; set; }
        public decimal DailyRate { get; set; }

        public override decimal CalculateFinalBill()
        {
            decimal total;
            return total = BaseFee + (DaysStayed * DailyRate);
        }
    }
    class Outpatient : Patient
    {
        public decimal ProcedureFee { get; set; }
        public override decimal CalculateFinalBill()
        {
            decimal total;
            return total = BaseFee + (ProcedureFee);
        }
    }
    class EmergencyPatient : Patient
    {
        public int SecurityLevel { get; set; }
        public override decimal CalculateFinalBill()
        {
            decimal total;
            return total = BaseFee * SecurityLevel;
        }
    }
    class HospitalBilling
    {
        private List<Patient> plist = new List<Patient>();
        public void AddPatient(Patient p)
        {
            plist.Add(p);
        }
        public void GenerateDailyReport()
        {
            foreach (Patient p in plist)
            {
                Console.WriteLine(
                    $"{p.Name} : {p.CalculateFinalBill().ToString("C2")}"
                );
            }
        }
        public decimal CalculateTotalRevenue()
        {
            decimal totalbill = 0;
            foreach (Patient p in plist)
            {
                totalbill += p.CalculateFinalBill();
            }
            return totalbill;
        }
        public int GetInpatientCount()
        {
            int count = 0;
            foreach (Patient p in plist)
            {
                if (p is Inpatient)
                    count++;
            }
            return count;
        }
    }
    internal class patient
    {
        static void Main(string[] args)
        {
            Console.OutputEncoding = System.Text.Encoding.UTF8;
            HospitalBilling billing = new HospitalBilling();
            billing.AddPatient(
                new Inpatient
                {
                    Name = "Yuraj",
                    BaseFee = 1000,
                    DaysStayed = 7,
                    DailyRate = 100
                });
            billing.AddPatient(new Inpatient
            {
                Name = "Tilak",
                BaseFee = 500,
                DaysStayed = 7,
                DailyRate = 100
            });
            billing.AddPatient(
                new Outpatient
                {
                    Name = "David",
                    BaseFee = 2000,
                    ProcedureFee = 100
                });
            billing.AddPatient(
                new EmergencyPatient
                {
                    Name = "Rahul",
                    BaseFee = 3000,
                    SecurityLevel = 2
                });
            Console.WriteLine("Daily Report ");
            billing.GenerateDailyReport();
            Console.WriteLine("Total Revenue : " + billing.CalculateTotalRevenue().ToString("C2"));
            Console.WriteLine("Inpatient count : " + billing.GetInpatientCount());
        }
    }
}
